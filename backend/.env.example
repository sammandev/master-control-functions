# Export these variables before starting the backend or migration command.
# The Go commands do not automatically load .env files.

# PostgreSQL URL components: username, password, host, port, database, TLS mode.
# Replace the placeholders and URL-encode reserved characters in credentials.
DATABASE_URL="postgresql://ptb:replace_me@localhost:5432/master_control_functions?sslmode=disable"

# sslmode=disable is for PostgreSQL on the same Ubuntu host over loopback only.
# If TLS is required, use sslmode=verify-full with a certificate for localhost.
# For a private certificate authority, append &sslrootcert=/path/to/ca.crt.

# Optional integration tests: authorized off-machine host only.
# Use a separate disposable database; tests create and drop isolated schemas.
# TEST_DATABASE_URL="postgresql://test_user:replace_me@localhost:5432/master_control_functions_test?sslmode=disable"
