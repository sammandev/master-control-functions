# The browser app uses same-origin /api; no public variables are required.
# Export these variables before running the database-backed Playwright suite.
# Playwright does not automatically load .env files.

# E2E resets database contents. Run only on the authorized off-machine host.
# Select a separate disposable database, never the production database.
# localhost is the Ubuntu host running both PostgreSQL and the test backend.
# Plaintext is for loopback only; use verified TLS if the host requires it.
E2E_DATABASE_URL="postgresql://test_user:replace_me@localhost:5432/master_control_functions_e2e?sslmode=disable"
E2E_GO=go
E2E_ADDR=127.0.0.1:8123
E2E_BASE_URL=http://127.0.0.1:8123
