@@ -0,0 +1,165 @@
+<script lang="ts">
+	import type { FunctionRow } from '$lib/api';
+	import { resolve } from '$app/paths';
+	import { Pencil, Trash2, Code, ExternalLink } from '@lucide/svelte';
+	import LinksPanel from '$lib/components/LinksPanel.svelte';
+	import ExamplesPanel from '$lib/components/ExamplesPanel.svelte';
+	import ComposeDialog from '$lib/components/ComposeDialog.svelte';
+	import Button from '$lib/components/ui/button.svelte';
+	import Badge from '$lib/components/ui/badge.svelte';
+	import * as Tabs from '$lib/components/ui/tabs/index';
+
+	let {
+		fn,
+		onEdit,
+		onDelete,
+		standalone = false
+	}: {
+		fn: FunctionRow;
+		onEdit?: (fn: FunctionRow) => void;
+		onDelete?: (fn: FunctionRow) => void;
+		standalone?: boolean;
+	} = $props();
+	let tab = $state('parameters');
+	let composeOpen = $state(false);
+</script>
+
+<section class="function-detail" aria-label="Function details">
+	<header>
+		<p class="ownership">Shared across Devices</p>
+		<svelte:element this={standalone ? 'h1' : 'h2'}>{fn.name}</svelte:element>
+		<div class="identity">
+			<Badge>{fn.source}</Badge><Badge class="max-w-full break-all whitespace-normal"
+				>{fn.interface}</Badge
+			>
+		</div>
+		{#if fn.description}<p class="description">{fn.description}</p>{/if}
+		<dl>
+			<div>
+				<dt>Category</dt>
+				<dd>{fn.category || '-'}</dd>
+			</div>
+			<div>
+				<dt>Execution role</dt>
+				<dd>{fn.execution_role || '-'}</dd>
+			</div>
+			<div>
+				<dt>Execution phase</dt>
+				<dd>{fn.execution_phase || '-'}</dd>
+			</div>
+			<div>
+				<dt>Convention</dt>
+				<dd>{fn.convention ?? '-'}</dd>
+			</div>
+			<div>
+				<dt>Updated</dt>
+				<dd>{fn.updated_at.slice(0, 10)}</dd>
+			</div>
+		</dl>
+		<div class="actions">
+			{#if onEdit}<Button variant="outline" onclick={() => onEdit?.(fn)}
+					><Pencil size={16} /> Edit function</Button
+				>{/if}
+			{#if onDelete}<Button variant="outline" onclick={() => onDelete?.(fn)}
+					><Trash2 size={16} /> Delete function</Button
+				>{/if}
+			<Button onclick={() => (composeOpen = true)}><Code size={16} /> Compose script</Button>
+			{#if !standalone}<a href={resolve('/functions/[id]', { id: String(fn.id) })}
+					><ExternalLink size={16} /> Manage function</a
+				>{/if}
+		</div>
+	</header>
+	<Tabs.Root bind:value={tab}>
+		<Tabs.List aria-label="Function sections">
+			<Tabs.Trigger value="parameters">Parameters</Tabs.Trigger>
+			<Tabs.Trigger value="criteria">Criteria</Tabs.Trigger>
+			<Tabs.Trigger value="examples">Examples</Tabs.Trigger>
+		</Tabs.List>
+		<Tabs.Content value="parameters" class="panel-scroll"
+			><LinksPanel
+				fnId={fn.id}
+				kind="parameter-links"
+				defKind="parameter-definitions"
+				noun="parameter"
+			/></Tabs.Content
+		>
+		<Tabs.Content value="criteria" class="panel-scroll"
+			><LinksPanel
+				fnId={fn.id}
+				kind="criteria-links"
+				defKind="criteria-definitions"
+				noun="criteria"
+			/></Tabs.Content
+		>
+		<Tabs.Content value="examples" class="panel-scroll"
+			><ExamplesPanel fixed={{ source: fn.source, name: fn.name }} /></Tabs.Content
+		>
+	</Tabs.Root>
+</section>
+
+{#if composeOpen}<ComposeDialog fnId={fn.id} onClose={() => (composeOpen = false)} />{/if}
+
+<style>
+	.function-detail {
+		min-width: 0;
+		padding: 24px;
+	}
+	.function-detail :global(.panel-scroll) {
+		max-width: 100%;
+		overflow-x: auto;
+	}
+	header {
+		margin-bottom: 24px;
+	}
+	header :global(h1),
+	header :global(h2) {
+		font-family: var(--mono);
+		font-size: 22px;
+		font-weight: 650;
+		overflow-wrap: anywhere;
+		margin: 8px 0;
+	}
+	.ownership,
+	dt {
+		color: var(--muted-foreground);
+		font-size: 12px;
+	}
+	.identity,
+	.actions {
+		display: flex;
+		align-items: center;
+		flex-wrap: wrap;
+		gap: 8px;
+	}
+	.description {
+		margin: 12px 0;
+		max-width: 65ch;
+		overflow-wrap: anywhere;
+	}
+	dl {
+		display: flex;
+		flex-wrap: wrap;
+		gap: 20px;
+		margin: 16px 0;
+	}
+	dd {
+		font-size: 13px;
+		overflow-wrap: anywhere;
+	}
+	.actions a {
+		display: inline-flex;
+		align-items: center;
+		gap: 6px;
+		color: var(--primary);
+		min-height: 32px;
+	}
+	.actions a:focus-visible {
+		outline: 2px solid var(--ring);
+		outline-offset: 3px;
+	}
+	@media (max-width: 600px) {
+		.function-detail {
+			padding: 20px 0;
+		}
+	}
+</style>
diff --git a/frontend/src/lib/components/FunctionDialog.svelte b/frontend/src/lib/components/FunctionDialog.svelte
new file mode 100644
index 0000000..4d97cee
--- /dev/null
+++ b/frontend/src/lib/components/FunctionDialog.svelte
@@ -0,0 +1,196 @@
+<script lang="ts">
+	import { onMount } from 'svelte';
+	import {
+		createFunction,
+		updateFunction,
+		deleteFunction,
+		ApiError,
+		type FunctionInput,
+		type FunctionRow
+	} from '$lib/api';
+	import type { DeviceFunctionRow } from '$lib/devices';
+	import Dialog from '$lib/components/ui/dialog.svelte';
+	import AlertDialog from '$lib/components/ui/alert-dialog.svelte';
+	import Select from '$lib/components/ui/select.svelte';
+	import Input from '$lib/components/ui/input.svelte';
+	import Label from '$lib/components/ui/label.svelte';
+	import Button from '$lib/components/ui/button.svelte';
+	import { toast } from 'svelte-sonner';
+
+	let {
+		mode,
+		fn,
+		defaults = {},
+		onClose,
+		onSaved
+	}: {
+		mode: 'create' | 'edit' | 'delete';
+		fn?: FunctionRow | DeviceFunctionRow;
+		defaults?: Partial<FunctionInput>;
+		onClose: () => void;
+		onSaved: (row: FunctionRow | null) => void | Promise<void>;
+	} = $props();
+	let form = $state<FunctionInput>({
+		source: 'DLL',
+		interface: '',
+		name: '',
+		description: '',
+		convention: null,
+		category: '',
+		execution_role: '',
+		execution_phase: ''
+	});
+	let fieldErrors = $state<Record<string, string>>({});
+	let submitError = $state('');
+	let saving = $state(false);
+	onMount(() => {
+		form = fn
+			? {
+					source: fn.source,
+					interface: fn.interface,
+					name: fn.name,
+					description: fn.description ?? '',
+					convention: fn.convention,
+					category: fn.category ?? '',
+					execution_role: fn.execution_role ?? '',
+					execution_phase: fn.execution_phase ?? ''
+				}
+			: { ...form, ...defaults };
+	});
+	function changeOpen(open: boolean) {
+		if (!open && !saving) onClose();
+	}
+	async function save() {
+		if (saving) return;
+		saving = true;
+		fieldErrors = {};
+		submitError = '';
+		try {
+			let row: FunctionRow | null;
+			if (mode === 'delete') {
+				if (!fn) throw new Error('No Function selected.');
+				await deleteFunction(fn.id);
+				row = null;
+			} else if (mode === 'edit') {
+				if (!fn) throw new Error('No Function selected.');
+				row = await updateFunction(fn.id, form);
+			} else row = await createFunction(form);
+			toast.success(
+				mode === 'create'
+					? 'Function created'
+					: mode === 'edit'
+						? 'Function updated'
+						: 'Function deleted'
+			);
+			await onSaved(row);
+			onClose();
+		} catch (error) {
+			if (error instanceof ApiError) fieldErrors = error.fields;
+			submitError = error instanceof Error ? error.message : String(error);
+		} finally {
+			saving = false;
+		}
+	}
+</script>
+
+{#if mode === 'delete'}
+	<AlertDialog
+		open={true}
+		onOpenChange={changeOpen}
+		title="Delete function"
+		description={fn
+			? `Shared across Devices. Delete function ${fn.source}/${fn.interface}/${fn.name}? Links and examples referencing it become unresolved. This cannot be undone.`
+			: ''}
+		confirmLabel={saving ? 'Deleting...' : 'Delete'}
+		onConfirm={() => {
+			void save();
+		}}
+	>
+		{#if submitError}<div class="banner-error" role="alert">{submitError}</div>{/if}
+	</AlertDialog>
+{:else}
+	<Dialog
+		open={true}
+		onOpenChange={changeOpen}
+		title={mode === 'create' ? 'New function' : `Edit function #${fn?.id}`}
+	>
+		<p class="muted mb-4">Shared across Devices</p>
+		{#if submitError}<div class="banner-error" role="alert">{submitError}</div>{/if}
+		<form
+			onsubmit={(event) => {
+				event.preventDefault();
+				void save();
+			}}
+		>
+			<div class="field">
+				<Label for="f-source">Source</Label><Select
+					id="f-source"
+					ariaLabel="Source"
+					bind:value={form.source}
+					options={[
+						{ value: 'BUILT-IN', label: 'BUILT-IN' },
+						{ value: 'DLL', label: 'DLL' }
+					]}
+				/>{#if fieldErrors.source}<span class="field-error">{fieldErrors.source}</span>{/if}
+			</div>
+			<div class="field">
+				<Label for="f-interface">Interface</Label><Input
+					id="f-interface"
+					bind:value={form.interface}
+				/>{#if fieldErrors.interface}<span class="field-error">{fieldErrors.interface}</span>{/if}
+			</div>
+			<div class="field">
+				<Label for="f-name">Name</Label><Input
+					id="f-name"
+					bind:value={form.name}
+				/>{#if fieldErrors.name}<span class="field-error">{fieldErrors.name}</span>{/if}
+			</div>
+			<div class="field">
+				<Label for="f-description">Description</Label><Input
+					id="f-description"
+					bind:value={form.description}
+				/>{#if fieldErrors.description}<span class="field-error">{fieldErrors.description}</span
+					>{/if}
+			</div>
+			<div class="field">
+				<Label for="f-convention">Convention</Label><Input
+					id="f-convention"
+					type="number"
+					value={form.convention ?? ''}
+					oninput={(event) => {
+						const value = event.currentTarget.value;
+						form.convention = value === '' ? null : Number(value);
+					}}
+				/>{#if fieldErrors.convention}<span class="field-error">{fieldErrors.convention}</span>{/if}
+			</div>
+			<div class="field">
+				<Label for="f-category">Category</Label><Input
+					id="f-category"
+					bind:value={form.category}
+				/>{#if fieldErrors.category}<span class="field-error">{fieldErrors.category}</span>{/if}
+			</div>
+			<div class="field">
+				<Label for="f-role">Execution role</Label><Input
+					id="f-role"
+					bind:value={form.execution_role}
+				/>{#if fieldErrors.execution_role}<span class="field-error"
+						>{fieldErrors.execution_role}</span
+					>{/if}
+			</div>
+			<div class="field">
+				<Label for="f-phase">Execution phase</Label><Input
+					id="f-phase"
+					bind:value={form.execution_phase}
+				/>{#if fieldErrors.execution_phase}<span class="field-error"
+						>{fieldErrors.execution_phase}</span
+					>{/if}
+			</div>
+			<div class="mt-4 flex justify-end gap-2">
+				<Button variant="outline" disabled={saving} onclick={onClose}>Cancel</Button><Button
+					type="submit"
+					disabled={saving}>{saving ? 'Saving...' : 'Save'}</Button
+				>
+			</div>
+		</form>
+	</Dialog>
+{/if}
