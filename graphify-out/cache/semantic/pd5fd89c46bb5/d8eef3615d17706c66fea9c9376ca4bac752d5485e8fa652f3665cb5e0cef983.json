{"nodes": [{"id": "deploy_readme_blue_green_deployment_runbook", "label": "Deploy README - Blue-Green Runbook", "file_type": "document", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_blue_green_release_strategy", "label": "Blue-Green Release Strategy", "file_type": "rationale", "source_file": "deploy/README.md", "source_location": "Layout; Routine Releases and Rollback", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two always-running slots (blue 24993, green 24994) behind one Nginx edge (31627) give zero-downtime releases with routing-only rollback; both slots share one PostgreSQL so schema changes must support old and new binaries concurrently."}, {"id": "deploy_readme_sqlite_to_postgres_transfer_gate", "label": "SQLite-to-PostgreSQL Transfer Gate", "file_type": "rationale", "source_file": "deploy/README.md", "source_location": "3. Transfer and Verify SQLite First", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First release is blocked until migrate-sqlite commits a consistent version-6 snapshot (11 tables) and --verify-only passes; --migration-verified is an operator assertion, not proof; workbook import must not substitute for the transfer."}, {"id": "deploy_readme_bun_docker_builder", "label": "Bun-in-Docker Frontend Builder", "file_type": "rationale", "source_file": "deploy/README.md", "source_location": "Layout; Verification Boundaries", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bun installs from the canonical pnpm lockfile with a temporary in-stage lockfile and runs checks/builds; Node stays in the builder because Windows bun --bun run build stalled at SSR startup; neither Bun nor Node ships to production."}, {"id": "deploy_readme_verification_boundaries", "label": "Verification Boundaries", "file_type": "rationale", "source_file": "deploy/README.md", "source_location": "Verification Boundaries", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "node --test rollout suite uses Docker/HTTP fakes; image build, Compose config, Nginx syntax, ports, firewall, transfer and live smoke checks remain Ubuntu operator gates; Paraglide plugin fetch failures from cdn.jsdelivr.net must be checked on the Ubuntu builder."}], "edges": [{"source": "deploy_readme_blue_green_release_strategy", "target": "deploy_compose_yml_blue_green_compose_stack", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "deploy/README.md", "source_location": "Layout table", "weight": 1.0}, {"source": "deploy_readme_blue_green_deployment_runbook", "target": "deploy_readme_blue_green_release_strategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/README.md", "source_location": "Routine Releases and Rollback", "weight": 1.0}, {"source": "deploy_readme_blue_green_deployment_runbook", "target": "deploy_readme_sqlite_to_postgres_transfer_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/README.md", "source_location": "Section 3", "weight": 1.0}, {"source": "deploy_readme_blue_green_deployment_runbook", "target": "deploy_readme_bun_docker_builder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/README.md", "source_location": "Layout; Verification Boundaries", "weight": 1.0}, {"source": "deploy_readme_blue_green_deployment_runbook", "target": "deploy_readme_verification_boundaries", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/README.md", "source_location": "Verification Boundaries", "weight": 1.0}], "hyperedges": [{"id": "blue_green_release_flow", "label": "Blue-Green Release Flow", "nodes": ["deploy_readme_blue_