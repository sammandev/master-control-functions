{"nodes": [{"id": "frontend__github_skills_svelte_core_bestpractices_skill_svelte_core_bestpractices", "label": "Svelte Core Best Practices", "file_type": "concept", "source_file": "frontend/.github/skills/svelte-core-bestpractices/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend__github_skills_svelte_core_bestpractices_skill_state_rune", "label": "$state rune", "file_type": "concept", "source_file": "frontend/.github/skills/svelte-core-bestpractices/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only for variables that must be reactive (drive an $effect, $derived or template update); objects and arrays are made deeply reactive via proxies, which carries performance overhead."}, {"id": "frontend__github_skills_svelte_core_bestpractices_skill_state_raw", "label": "$state.raw", "file_type": "concept", "source_file": "frontend/.github/skills/svelte-core-bestpractices/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trade-off: deep reactivity proxies objects for fine-grained updates at a performance cost; use $state.raw for large objects that are only ever reassigned rather than mutated, such as API responses."}, {"id": "frontend__github_skills_svelte_core_bestpractices_skill_derived_rune", "label": "$derived rune", "file_type": "concept", "source_file": "frontend/.github/skills/svelte-core-bestpractices/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compute from state with $derived rather than $effect; deriveds are writable and re-evaluate when their expression changes; use $derived.by when the expression is complex."}, {"id": "frontend__github_skills_svelte_core_bestpractices_skill_effect_rune", "label": "$effect rune", "file_type": "concept", "source_file": "frontend/.github/skills/svelte-core-bestpractices/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Effects are an escape hatch and should mostly be avoided; never update state inside effects and never wrap them in if (browser) because effects do not run on the server."}, {"id": "frontend__github_skills_svelte_core_bestpractices_skill_props_rune", "label": "$props rune", "file_type": "concept", "source_file": "frontend/.github/skills/svelte-core-bestpractices/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Treat props as though they will change: values that depend on props should usually be $derived so they update when the prop changes."}, {"id": "frontend__github_skills_svelte_core_bestpractices_skill_events", "label": "Event attributes (onclick)", "file_type": "rationale", "source_file": "frontend/.github/skills/svelte-core-bestpractices/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any element attribute starting with on is an event listener; attach window/document listeners with <svelte:window>/<svelte:document> instead of onMount or $effect."}, {"id": "frontend__github_skills_svelte_core_bestpractices_skill_css_custom_properties", "label": "CSS custom properties for styling", "file_type": "rationale", "source_file": "frontend/.github/skills/svelte-core-bestpractices/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Component CSS is scoped, so parents control child styles through CSS custom properties (style:-- directive or --color props) and use :global only as a fallback for library components."}, {"id": "frontend__github_skills_svelte_core_bestpractices_skill_context", "label": "Context API (createContext)", "file_type": "concept", "source_file": "frontend/.github/skills/svelte-core-bestpractices/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scope state to the part of the app that needs it and eliminate the possibility of it leaking between users during server-side rendering; createContext is preferred over setContext/getContext for type safety."}, {"id": "frontend__github_skills_svelte_core_bestpractices_skill_runes_mode", "label": "Runes mode", "file_type": "rationale", "source_file": "frontend/.github/skills/svelte-core-bestpractices/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always use runes mode for new code and prefer modern replacements over legacy features: $state over implicit reactivity, $derived/$effect over $:, $props over export let, onclick over on:click, snippets over slots, {@attach} over use:action, classes with $state fields over stores."}, {"id": "frontend__github_skills_svelte_core_bestpractices_skill_inspect_trace", "label": "$inspect.trace", "file_type": "concept", "source_file": "frontend/.github/skills/svelte-core-bestpractices/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Debugging tool for reactivity: add as the first line of an $effect or $derived.by to trace which reactive dependency triggered the re-run."}], "edges": [{"source": "frontend__github_skills_svelte_core_bestpractices_skill_svelte_core_bestpractices", "target": "frontend__github_skills_svelte_core_bestpractices_skill_state_rune", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/.github/skills/svelte-core-bestpractices/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "frontend__github_skills_svelte_core_bestpractices_skill_svelte_core_bestpractices", "target": "frontend__github_skills_svelte_core_bes