{"nodes": [{"id": "deploy_readme_blue_green_deployment", "label": "Ubuntu Blue-Green Deployment", "file_type": "rationale", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero-downtime releases via two persistent slots; both slots stay running after a release for rollback; script refuses to proceed when configured/live routing disagree; failure restores previous upstream file."}, {"id": "deploy_readme_nginx_edge", "label": "Nginx Edge Listener (port 31627)", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_blue_release", "label": "Blue Release Slot (127.0.0.1:24993)", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_green_release", "label": "Green Release Slot (127.0.0.1:24994)", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_postgresql", "label": "Existing PostgreSQL (127.0.0.1:5432)", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stable database kept outside Compose; reachable through loopback only, never opened to a Docker subnet."}, {"id": "deploy_readme_host_networking", "label": "Linux Host Networking", "file_type": "rationale", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen so the database remains reachable through loopback without opening PostgreSQL to a Docker subnet; trade-off is reduced network isolation, compensated by private ports, non-root processes, dropped capabilities, and read-only filesystems."}, {"id": "deploy_readme_bun_frontend_builder", "label": "Bun Frontend Builder (Docker build stage)", "file_type": "code", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows `bun --bun run build` stalled at SSR startup while the Node-backed build completed, so Docker uses Bun only as installer/runner over the canonical pnpm lockfile while retaining Node 24 tooling in the builder; the temporary Bun lockfile exists only inside the build stage to avoid a second repository lockfile."}, {"id": "deploy_readme_go_builder", "label": "Go Builder (PostgreSQL-client-only server)", "file_type": "code", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_alpine_runtime_image", "label": "Non-root Alpine Runtime Image", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contains only the Go executable, frontend files and CA certificates; neither Bun nor Node runs in production."}, {"id": "deploy_readme_blue_green_sh", "label": "deploy/blue-green.sh", "file_type": "code", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_migrate_sqlite", "label": "migrate-sqlite transfer tool (cmd/migrate-sqlite)", "file_type": "code", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate transfer tool containing the legacy SQLite reader; deliberately never copied into the application image so the runtime image stays PostgreSQL-client-only."}, {"id": "deploy_readme_sqlite_migration_tag", "label": "sqlite_migration build tag", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normal builds exclude the SQLite engine; the tag gates the transfer tool and its regressions and is used only on the approved Ubuntu host."}, {"id": "deploy_readme_sqlite_snapshot", "label": "Consistent SQLite v6 Snapshot (catalog-snapshot.db)", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transfer requires a consistent version-6 snapshot staged with WAL/SHM companions; a main-file copy without required WAL data is not a valid snapshot; original SQLite files remain untouched as rollback evidence."}, {"id": "deploy_readme_pg_dump_backup", "label": "pg_dump Pre-migration Backup (program-functions-before.dump)", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_master_control_functions_test", "label": "master_control_functions_test Disposable Test Database", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disposable database for the same role so tagged regressions never touch the production catalog; full UI E2E reset also requires its own disposable database."}, {"id": "deploy_readme_env_file", "label": "deploy/.env (credentials)", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds rotated PostgreSQL password in PGPASSWORD; kept owner-readable only (600); build settings here are not loaded into the script's shell."}, {"id": "deploy_readme_env_proxy", "label": "deploy/.env.proxy (build proxy settings)", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate from deploy/.env because Compose loads .env into application containers at runtime; proxy exports are forwarded by the script to Docker as build secrets exposed only to network-reaching build steps, never appearing on the command line, in image history, or in build cache metadata."}, {"id": "deploy_readme_build_network_access", "label": "Build Network Access (BuildKit outbound HTTPS)", "file_type": "rationale", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep TLS verification and Go checksum verification enabled; GOPROXY comma-fallback triggers only on HTTP 404/410 so a connection reset will not trigger direct downloads; public-mirror retries cannot repair a host network policy blocking every mirror."}, {"id": "deploy_readme_go_toolchain", "label": "Go 1.27.1 Toolchain (golang:1.27.1-alpine)", "file_type": "code", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Host Go 1.22 from the package inventory is too old for the tagged migration build."}, {"id": "deploy_readme_blue_green_tests", "label": "deploy/tests/blue-green.test.mjs rollout tests", "file_type": "code", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replace Docker and HTTP commands with fakes and never start services or access a database; passing mocked tests do not establish real zero-downtime behavior or measured performance."}, {"id": "deploy_readme_compose_yml", "label": "deploy/compose.yml", "file_type": "code", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_state_dir", "label": "state/ Private Operational State", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_rollback", "label": "Routing-only Rollback", "file_type": "rationale", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rollback changes application routing only and does not reverse migrations or restore data; schema changes must support old and new binaries concurrently; after new PostgreSQL writes the SQLite snapshot is stale and there is no automatic SQLite fallback."}, {"id": "deploy_readme_migration_verified_flag", "label": "--migration-verified flag", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An operator assertion that the transfer passed; it does not perform or independently prove migration."}], "edges": [{"source": "deploy_readme_blue_green_deployment", "target": "deploy_readme_nginx_edge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/README.md", "source_location": null, "weight": 1.0}, {"source": "deploy_readme_blue_green_deployment", "target": "deploy_readme_blue_release", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/README.md", "source_location": null, "weight": 1.0}, {"source": "deploy_readme_blue_green_deployment", "target": "deploy_readme_green_release", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/README.md", "source_location": null, "weight": 1.0}, {"source": "d