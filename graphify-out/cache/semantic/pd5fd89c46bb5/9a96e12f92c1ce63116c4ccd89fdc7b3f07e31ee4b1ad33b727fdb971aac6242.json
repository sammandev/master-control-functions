{"nodes": [{"id": "docs_adr_0001_stack_go_fiber_svelte5_sqlite", "label": "ADR-0001: Stack - Go (Fiber) + Svelte 5, SQLite with PostgreSQL Exit Path", "file_type": "document", "source_file": "docs/adr/0001-stack-go-fiber-svelte5-sqlite.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0001_stack_go_fiber_svelte5_sqlite_stack_decision", "label": "Go+Svelte Stack Decision with SQLite Starter", "file_type": "rationale", "source_file": "docs/adr/0001-stack-go-fiber-svelte5-sqlite.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single Go binary (Fiber HTTP + static serving) + Svelte 5 SPA; SQLite is explicitly temporary with a clean path to PostgreSQL; FastAPI+React, cgo sqlite3, and GORM were rejected (an ORM hinders the planned database swap)."}, {"id": "docs_adr_0001_stack_go_fiber_svelte5_sqlite_portability_discipline", "label": "ANSI-Compatible SQL Portability Discipline", "file_type": "rationale", "source_file": "docs/adr/0001-stack-go-fiber-svelte5-sqlite.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All SQL stays ANSI-compatible - no SQLite-only functions, no AUTOINCREMENT, ISO-8601 timestamps, no PRAGMA-dependent logic - so migrating to PostgreSQL + pgx is a driver swap, not a rewrite."}, {"id": "docs_adr_0001_stack_go_fiber_svelte5_sqlite_modernc_sqlite_driver", "label": "modernc.org/sqlite Pure-Go Driver", "file_type": "concept", "source_file": "docs/adr/0001-stack-go-fiber-svelte5-sqlite.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_adr_0001_stack_go_fiber_svelte5_sqlite_stack_decision", "target": "docs_adr_0001_stack_go_fiber_svelte5_sqlite", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/